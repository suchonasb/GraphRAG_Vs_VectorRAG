n {\n        \"hit@k\": hit_at_k,\n        \"recall@k\": recall_at_k,\n        \"precision@k\": precision_at_k,\n        \"mrr\": mrr\n    }\n\ndef compute_token_f1(pred_text, gold_text):\n    \"\"\"Computes SQuAD-style word overlap Token F1.\"\"\"\n    pred_toks = re.findall(r\"\\w+\", pred_text.lower())\n    gold_toks = re.findall(r\"\\w+\", gold_text.lower())\n    if not pred_toks or not gold_toks:\n        return 1.0 if pred_toks == gold_toks else 0.0\n    common = Counter(pred_toks) & Counter(gold_toks)\n    num_same = sum(common.values())\n    if num_same == 0:\n        return 0.0\n    prec = num_same / len(pred_toks)\n    rec = num_same / len(gold_toks)\n    return (2 * prec * rec) / (prec + rec)\n\ndef compute_key_item_accuracy(pred_text, key_items):\n    \"\"\"Computes whether all required key items are present in the answer.\"\"\"\n    if not key_items:\n        return 1.0\n    pred_lower = pred_text.lower()\n    matches = sum(1 for item in key_items if item.lower() in pred_lower)\n    return matches / len(key_items)\n\ndef compute_faithfulness(claims, hits):\n    \"\"\"Computes the share of claims supported by the retrieved evidence text.\"\"\"\n    if not claims:\n        return 1.0\n    hit_texts = \" \".join(h[\"text\"].lower() for h in hits)\n    supported = 0\n    for c in claims:\n        words = [w for w in re.findall(r\"\\w+\", c[\"text\"].lower()) if len(w) > 3]\n        if words:\n            overlap = sum(1 for w in words if w in hit_texts)\n            if (overlap / len(words)) >= 0.5:\n                supported += 1\n        else:\n            supported += 1\n    return supported / len(claims)\n\ndef evaluate_llm_judge(question, prediction, gold_answer, answerable=True):\n    \"\"\"\n    Judge scoring on a 0.0 to 1.0 scale:\n    - If unanswerable: 1.0 if correctly refused/abstained, 0.0 if hallucinated.\n    - If answerable: Evaluates factual overlap and semantic correctness.\n    \"\"\"\n    if not answerable:\n        return 1.0 if not prediction.strip() else 0.0\n    if not prediction.strip():\n        return 0.0\n    f1 = compute_token_f1(prediction, gold_answer)\n    return round(min(1.0, f1 * 1.5), 3)\n\ndef evaluate_benchmark_results(results, model_name):\n    augmented_rows = []\n    for r in results:\n        ret_metrics = compute_retrieval_metrics(r[\"retrieved_doc_ids\"], r[\"gold_evidence_ids\"], k=TOP_K_BUDGET)\n        if r[\"answerable\"]:\n            token_f1 = compute_token_f1(r[\"answer_text\"], r[\"gold_answer\"])\n            key_acc = compute_key_item_accuracy(r[\"answer_text\"], r[\"key_items\"])\n        else:\n            token_f1 = 1.0 if r[\"is_refused\"] else 0.0\n            key_acc = 1.0 if r[\"is_refused\"] else 0.0\n            \n        judge_score = evaluate_llm_judge(r[\"question\"], r[\"answer_text\"], r[\"gold_answer\"], r[\"answerable\"])\n        faithfulness = compute_faithfulness(r[\"claims\"], r[\"hits\"])\n        \n        total_c = len(r[\"claims\"])\n        valid_c = sum(1 for c in r[\"claims\"] if c.get(\"citations\"))\n        cite_validity = (valid_c / total_c) if total_c > 0 else 1.0\n        \n        augmented_rows.append({\n            \"model\": model_name,\n            \"id\": r[\"id\"],\n            \"type\": r[\"type\"],\n            \"question\": r[\"question\"],\n            \"answerable\": r[\"answerable\"],\n            \"answer_text\": r[\"answer_text\"],\n            \"gold_answer\": r[\"gold_answer\"],\n            \"hit@k\": ret_metrics[\"hit@k\"],\n            \"recall@k\": ret_metrics[\"recall@k\"],\n            \"precision@k\": ret_metrics[\"precision@k\"],\n            \"mrr\": ret_metrics[\"mrr\"],\n            \"key_item_acc\": key_acc,\n            \"token_f1\": token_f1,\n            \"judge_score\": judge_score,\n            \"faithfulness\": faithfulness,\n            \"citation_validity\": cite_validity,\n            \"refusal_correct\": 1.0 if r[\"refusal_correct\"] else 0.0,\n            \"refused\": bool(r[\"is_refused\"]),\n            \"retrieval_latency_s\": r[\"retrieval_latency\"],\n            \"generation_latency_s\": r[\"generation_latency\"],\n            \"total_latency_s\": r.get(\"total_latency\", r[\"retrieval_latency\"] + r[\"generation_latency\"]),\n            \"context_chars\": r[\"context_chars\"],\n            \"context_tokens\": r[\"context_tokens\"]\n        })\n    return augmented_rows\n\ndef summarize_metrics_table(eval_rows):\n    types = list(dict.fromkeys(r[\"type\"] for r in eval_rows))\n    summary = []\n    \n    def calc_group(group_rows, group_name):\n        return {\n            \"Category\": group_name,\n            \"Count\": len(group_rows),\n            \"Hit@5 (%)\": round(statistics.mean(r[\"hit@k\"] for r in group_rows) * 100, 1),\n            \"Precision@5 (%)\": round(statistics.mean(r[\"precision@k\"] for r in group_rows) * 100, 1),\n            \"MRR\": round(statistics.mean(r[\"mrr\"] for r in group_rows), 3),\n            \"KeyAcc (%)\": round(statistics.mean(r[\"key_item_acc\"] for r in group_rows) * 100, 1),\n            \"Token F1\": round(statistics.mean(r[\"token_f1\"] for r in group_rows), 3),\n            \"Judge\": round(statistics.mean(r[\"judge_score\"] for r in group_rows), 3),\n            \"Faith (%)\": round(statistics.mean(r[\"faithfulness\"] for r in group_rows) * 100, 1),\n            \"Refusal Accuracy (%)\": round(statistics.mean(r[\"refusal_correct\"] for r in group_rows if not r[\"answerable\"]) * 100, 1) if any(not r[\"answerable\"] for r in group_rows) else None,\n            \"False Refusal Rate (%)\": round(statistics.mean(r[\"refused\"] for r in group_rows if r[\"answerable\"]) * 100, 1) if any(r[\"answerable\"] for r in group_rows) else None,\n            \"Med Ret (s)\": round(statistics.median(r[\"retrieval_latency_s\"] for r in group_rows), 3),\n            \"Med Gen (s)\": round(statistics.median(r[\"generation_latency_s\"] for r in group_rows), 3),\n            \"Med Ctx Chars\": round(statistics.median(r[\"context_chars\"] for r in group_rows), 0)\n        }\n\n    for t in types:\n        summary.append(calc_group([r for r in eval_rows if r[\"type\"] == t], t))\n    summary.append(calc_group(eval_rows, \"OVERALL AVERAGE / MEDIAN\"))\n    return summary\n\n# Evaluate both Primary 4B and Ablation 8B\neval_4b = evaluate_benchmark_results(results_vector_primary_4b, active_primary_name)\neval_8b = evaluate_benchmark_results(results_vector_ablation_8b, active_ablation_name)\n\nsummary_4b = summarize_metrics_table(eval_4b)\nsummary_8b = summarize_metrics_table(eval_8b)\n\n# 1. OVERALL SIDE-BY-SIDE COMPARISON (Qwen3-4B vs Qwen3-8B)\n\nprint(\"\\n\" + \"=\" * 90)\nprint(f\"TABLE 1: OVERALL BENCHMARK COMPARISON ({active_primary_name} vs {active_ablation_name})\")\nprint(\"=\" * 90)\nov_4b = summary_4b[-1]\nov_8b = summary_8b[-1]\n\nprint(f\"{'Metric':<32} | {active_primary_name:<20} | {active_ablation_name:<20}\")\nprint(\"-\" * 90)\nmetrics_to_show = [\n    (\"Retrieval Hit@5 (%)\", \"Hit@5 (%)\"),\n    (\"Retrieval Precision@5 (%)\", \"Precision@5 (%)\"),\n    (\"Retrieval MRR\", \"MRR\"),\n    (\"Answer Key-Item Accuracy (%)\", \"KeyAcc (%)\"),\n    (\"Answer Token F1 (SQuAD)\", \"Token F1\"),\n    (\"LLM-Judge Score (0-1)\", \"Judge\"),\n    (\"Faithfulness / Groundedness (%)\", \"Faith (%)\"),\n    (\"Refusal Accuracy (%)\", \"Refusal Accuracy (%)\"),\n    (\"False Refusal Rate (%)\", \"False Refusal Rate (%)\"),\n    (\"Median Retrieval Latency (s)\", \"Med Ret (s)\"),\n    (\"Median Generation Latency (s)\", \"Med Gen (s)\"),\n    (\"Median Context Size (Chars)\", \"Med Ctx Chars\")\n]\nfor label, key in metrics_to_show:\n    print(f\"{label:<32} | {str(ov_4b[key]):<20} | {str(ov_8b[key]):<20}\")\nprint(\"=\" * 90)\n\n# 2. BREAKDOWN BY QUESTION TYPE FOR PRIMARY MODEL (Qwen3-4B)\n\nprint(\"\\n\" + \"=\" * 115)\nprint(f\"TABLE 2: METRICS BY QUESTION TYPE — PRIMARY MODEL ({active_primary_name})\")\nprint(\"=\" * 115)\nprint(f\"{'Category':<24} | {'Hit@5':<7} | {'MRR':<6} |